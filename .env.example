# Copy to .env.local and fill in. Never commit real keys.

# Resend API key — https://resend.com/api-keys (needs "Full access" to create contacts)
RESEND_API_KEY=

# Sender for the confirmation email. The domain must be verified in Resend.
# Until then, "English Boarding Pass <onboarding@resend.dev>" works for testing
# (it can only deliver to your own Resend account email).
RESEND_FROM_EMAIL="English Boarding Pass <hello@example.com>"

# Optional: Resend audience to save waitlist contacts into.
# Leave empty to save them to the account's main contact list.
RESEND_AUDIENCE_ID=

# Optional: comma-separated inbox(es) that get an email for every new signup.
# Also used as the reply-to on the confirmation email.
WAITLIST_NOTIFY_EMAIL=
