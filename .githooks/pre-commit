#!/bin/sh
# Fast checks on staged files only: ESLint + Prettier (and the locale key check
# when messages/*.json changes). Config lives under "lint-staged" in package.json.
# Skip in an emergency with: git commit --no-verify

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit: npx not found - install Node.js 20+ to run the checks." >&2
  exit 1
fi

npx --no-install lint-staged
